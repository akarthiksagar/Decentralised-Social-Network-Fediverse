NODE_ENV=production
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Redis for BullMQ federation delivery
REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Public URLs/domains
PUBLIC_BASE_URL=https://api.example.com
CLIENT_URL=https://app.example.com
CLIENT_URLS=https://app.example.com,https://www.example.com
SERVER_DOMAIN=api.example.com
LOCAL_DOMAIN=api.example.com
INSTANCE_NAME=Example Social
INSTANCE_RULES=No harassment|No spam|Use content warnings for sensitive media
REGISTRATIONS_OPEN=true

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Federation behavior
REQUIRE_HTTP_SIGNATURES=true
ALLOW_HTTP_FEDERATION=false
FEDERATION_DELIVERY_ATTEMPTS=5
FEDERATION_DELIVERY_BACKOFF_MS=5000
FEDERATION_DELIVERY_CONCURRENCY=5
FEDERATION_QUEUE_TIMEOUT_MS=1500
FEDERATION_DISCOVERY_TIMEOUT_MS=5000
